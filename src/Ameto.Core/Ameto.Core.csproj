<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- NO <FrameworkReference Include="Microsoft.AspNetCore.App" /> here. It is transitive:
         it lands in the runtimeconfig.json of every console tool that links Core (tools/loggen),
         which then refuses to start on a host that has only the .NET runtime installed.
         SseJsonWriter lives here and takes a Stream for exactly that reason. -->
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="MessagePack.Annotations" Version="3.1.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- IngestBufferPool.Observer: lets the integration tests prove /api/events rents every
         body buffer from that pool and returns each one to it exactly once. -->
    <InternalsVisibleTo Include="Ameto.Integration.Tests" />
    <!-- BoundedByteArrayPool: its depth and byte caps are testable with small numbers only by
         constructing one, which the process-wide IngestBufferPool cannot be asked to do. -->
    <InternalsVisibleTo Include="Ameto.Core.Tests" />
  </ItemGroup>

</Project>
