<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Lets the integration tests pin IngestionEndpoint.IsMalformedPayload, which decides
         whether a failure is the client's (400) or the server's (500). -->
    <InternalsVisibleTo Include="Ameto.Integration.Tests" />
    <!-- The Perf probes drive the ring buffer's payload arena and its commit-failure hook. -->
    <InternalsVisibleTo Include="Ameto.Perf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ameto.Core\Ameto.Core.csproj" />
    <ProjectReference Include="..\Ameto.Storage\Ameto.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <!-- The shared framework, not the 2.3.0 NuGet package this used to compile against. The
         package's HttpResponse predates PipeWriter, so the ingest reply could only be written
         through a string; the project already RAN on the 10.0 assembly (same simple name, so
         the runtime unified them) — it just could not see its surface. Safe to make transitive
         here: the only consumers are Ameto.Otel, Ameto.Server and Ameto.Perf, and the first
         two already carry this reference. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
