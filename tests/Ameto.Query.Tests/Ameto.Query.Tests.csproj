<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Segments an earlier build wrote, read by this one (CaseFoldTierParityTests). -->
    <None Include="Fixtures\**\*.seg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Removes a test's data directory, and fails the test when something still holds a file in it;
         QuerySegmentFixtures.DeleteDataDirectory is this. -->
    <Compile Include="..\Shared\TestDataDirectory.cs" Link="Shared\TestDataDirectory.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ameto.Core\Ameto.Core.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Query\Ameto.Query.csproj" />
    <!-- Both arrive transitively through Ameto.Query; named here because this suite now writes
         real segments (StorageEngine) and builds real indexes over them (SegmentIndexBuilder)
         to test the prefilter against, rather than only parsing and evaluating filters. -->
    <ProjectReference Include="..\..\src\Ameto.Storage\Ameto.Storage.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Indexing\Ameto.Indexing.csproj" />
  </ItemGroup>

</Project>