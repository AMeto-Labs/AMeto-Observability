<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <StartupObject>Ameto.Perf.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The merge planner's bucket grid, shared with Ameto.Storage.Tests rather than copied:
         MergeBucketGridSweepTests machine-checks that helper across a full bucket period, and a
         second copy here would be a second thing to keep true with nothing checking it. -->
    <Compile Include="..\Ameto.Storage.Tests\MergeBucketGrid.cs" Link="MergeBucketGrid.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ameto.Core\Ameto.Core.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Storage\Ameto.Storage.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Ingestion\Ameto.Ingestion.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Indexing\Ameto.Indexing.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Otel\Ameto.Otel.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Query\Ameto.Query.csproj" />
  </ItemGroup>

</Project>