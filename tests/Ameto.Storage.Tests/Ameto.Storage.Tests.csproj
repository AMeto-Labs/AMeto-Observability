<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ameto.Core\Ameto.Core.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Storage\Ameto.Storage.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Metrics\Ameto.Metrics.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Tracing\Ameto.Tracing.csproj" />
    <!-- StreamingMergeOrderTests merges with the REAL index wiring and then reads the merged
         file back through a query — a merge that mis-numbers a group's ordinals loses rows at
         query time, where no count notices. Proving that needs the builder and the executor,
         not stand-in sinks. -->
    <ProjectReference Include="..\..\src\Ameto.Indexing\Ameto.Indexing.csproj" />
    <ProjectReference Include="..\..\src\Ameto.Query\Ameto.Query.csproj" />
  </ItemGroup>

</Project>